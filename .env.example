APP_NAME=Hotel KHQR Payment Service
APP_ENV=development
DATABASE_URL=sqlite:///./payments.db
INTERNAL_API_KEY=change-this-long-random-key

# mock = local development, bakong = real KHQR integration
KHQR_PROVIDER=mock
KHQR_TTL_MINUTES=10

# Required only when KHQR_PROVIDER=bakong
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=your_name@bank
BAKONG_MERCHANT_NAME=Your Hotel
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_STORE_LABEL=Hotel Booking
BAKONG_PHONE_NUMBER=

# Hotel Server callback (leave blank to disable during local development)
HOTEL_API_BASE_URL=http://localhost:8030
HOTEL_CALLBACK_PATH=/api/v1/internal/bookings/{booking_id}/payment-confirmed
HOTEL_SERVICE_API_KEY=change-this-hotel-service-key

